# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. onboarding@resend.dev only delivers to the email on your Resend account.
# After you verify a domain, use an address on that domain.
RESEND_FROM="Fashion Supply <onboarding@resend.dev>"

# Scrapling sidecar (Python scraping service in scraper_service/).
# Start it with: SCRAPER_TOKEN=<same value> scraper_service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8100
# Generate a token with: python3 -c "import secrets; print(secrets.token_hex(24))"
SCRAPER_SIDECAR_URL=http://127.0.0.1:8100
SCRAPER_TOKEN=

# Supabase Postgres
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# Google Gemini API key (https://aistudio.google.com/apikey) — enables AI
# photo categorization (title, gender, category) for scraped products.
# Without a key, products are kept as ai_status='pending' and can be
# backfilled later with: node --import tsx scripts/categorize-products.ts
GEMINI_API_KEY=

# Reviewed commerce rollout. Keep disabled until migrations and pilot checks pass.
SHOP_V2_ENABLED=0
SCHEMA_MANAGED=0
MIGRATION_DATABASE_URL=
SHOP_DATABASE_URL=
SHOP_DB_APP_PASSWORD=
SHOP_DB_MIGRATION_PASSWORD=
SUPABASE_INTERNAL_URL=http://supabase-envoy:8000
SUPABASE_SERVICE_ROLE_KEY=
APP_PUBLIC_URL=https://fashion-supply.store
GEMINI_MODEL=gemini-2.5-flash
# Local isolated tests only (database name must start with fashion_shop_test).
TEST_DATABASE_URL=postgres://superno@127.0.0.1:55439/fashion_shop_test

# Catalog sorting agent: only enable after explicit approval to send catalog images.
CATALOG_AGENT_PROVIDER=gemini
CATALOG_AGENT_MODEL=gemini-3.8-flash
CATALOG_AGENT_IMAGE_CONSENT=
CATALOG_AGENT_MIN_PRODUCT_ID=
CATALOG_AGENT_MIN_MEDIA_ID=

# AI listing assistant (/admin/listing). Sends product photos to Google Gemini.
# It only works when LISTING_AI_IMAGE_CONSENT=gemini is set on purpose.
# Key lookup order: LISTING_AI_API_KEY, then CATALOG_AGENT_API_KEY, then GEMINI_API_KEY.
# Model photos need a Google project with billing: the free tier has no image quota (HTTP 429).
LISTING_AI_IMAGE_CONSENT=
LISTING_AI_API_KEY=
LISTING_AI_MODEL=
LISTING_IMAGE_MODEL=
